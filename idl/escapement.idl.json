    {
      "name": "AsPda",
      "tag": 11,
      "docs": "A user transition sent by another program as one of its own PDAs (a multisig, DAO or\nlaunchpad vault). Accepted only when the immediate sender's program derives the receiving\naccount from `seed` (`for_public_pda(sender_program, seed) == receiver`), so neither a\nsigner's authority nor an inherited seed grant can be relayed by a third program.",
      "fields": [
        {
          "name": "seed",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "call",
          "type": {
            "defined": "PdaCall"
          }
        }
      ]
    }
